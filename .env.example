# ---- ConstructPay environment variables ----

# Local development (SQLite, zero-config):
DATABASE_URL="file:./dev.db"

# Production (Vercel / hosted): use a PostgreSQL connection string instead.
# The Prisma provider switches to "postgresql" automatically when the URL
# starts with postgres:// or postgresql://. Example (Neon / Vercel Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign session JWTs. MUST be a long random string in production.
JWT_SECRET="dev-only-change-me-constructpay-super-secret-key-32min"

# App URL (used for Google OAuth redirect)
NEXTAUTH_URL=""
NEXTAUTH_SECRET="dev-nextauth-secret-change-in-production"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Platform Owner Google email (bootstrapped on first Google sign-in)
SUPER_ADMIN_GOOGLE_EMAIL=""

# OpenAI — bill scanning OCR pre-fill
OPENAI_API_KEY=""